OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-transcribe

API_HOST=0.0.0.0
API_PORT=8004

QUEUE_SIZE=512
PIPELINE_WORKERS=32
CELERY_CONCURRENCY=1
BACKPRESSURE_RETRY_AFTER_SECONDS=30
UPLOAD_WAIT_TIMEOUT_SECONDS=120
UPLOAD_WAIT_POLL_SECONDS=0.5

REDIS_URL=redis://localhost:6379/0

AUDIO_TTL_SECONDS=3600
RESULT_TTL_SECONDS=86400

MAX_AUDIO_FILES=20
MAX_AUDIO_SIZE_MB=25

SAMPLE_RATE=16000
CHANNELS=1
SAMPLE_WIDTH=2

LOG_DIR=app/logs
LOG_FILE=app.log
LOG_LEVEL=INFO
