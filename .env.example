OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-transcribe

QUEUE_SIZE=512
PIPELINE_WORKERS=32
BACKPRESSURE_RETRY_AFTER_SECONDS=30
UPLOAD_WAIT_TIMEOUT_SECONDS=120
UPLOAD_WAIT_POLL_SECONDS=0.5

REDIS_URL=redis://localhost:6379/0

AUDIO_TTL_SECONDS=3600
RESULT_TTL_SECONDS=86400

MAX_AUDIO_FILES=20
MAX_AUDIO_SIZE_MB=25

WEBRTC_VAD_MODE=3
VAD_FRAME_MS=30
VAD_END_SILENCE_MS=300
VAD_PADDING_MS=200

SILERO_THRESHOLD=0.5
SILERO_FRAME_SIZE=512

SAMPLE_RATE = 16_000
CHANNELS = 1
SAMPLE_WIDTH = 2  # int16 = 2 bytes

LOG_DIR=app/logs
LOG_FILE=app.log
LOG_LEVEL=INFO
